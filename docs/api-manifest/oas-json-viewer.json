      "name": "oas-parse-error"
    },
    {
      "name": "oas-toggle",
      "detail": "{ path, expanded } satisfies JsonViewerToggleDetail"
    },
    {
      "name": "oas-search-change",
      "detail": "{ query, matches: 0, activeIndex: -1 } | { query, matches: this.searchMatches.length, activeIndex: this.searchMatches.length ? this.activeMatch : -1, } satisfies JsonViewerSearchChangeDetail"
    },
    {
      "name": "oas-expanded-change",
      "detail": "{ paths } satisfies JsonViewerExpandedChangeDetail"
    },
    {
      "name": "oas-copy-error",
      "detail": "{ path, kind, text: '', error } satisfies JsonViewerCopyDetail & { error: unknown } | { path, kind, text, error } satisfies JsonViewerCopyDetail & { error: unknown }"
    },
    {
      "name": "oas-copy",
      "detail": "{ path, kind, text } satisfies JsonViewerCopyDetail"
    },
    {
      "name": "oas-copied",
