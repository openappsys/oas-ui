    {
      "name": "oas-filter-change",
      "detail": "{ filters: values }"
    },
    {
      "name": "oas-expand",
      "detail": "{ key, expanded }"
    },
    {
      "name": "oas-export",
      "detail": "{ format, fileName, rowCount: rows.length }"
    },
    {
      "name": "oas-row-reorder",
      "detail": "{ from, to, row } | { from: index, to, row }"
    },
    {
      "name": "oas-sort-change",
      "detail": "{ key, order: nextOrder } | { key, order: sorts.find((s) => s.key === key)?.order ?? '' }"
    },
    {
      "name": "oas-scroll",
      "detail": "{ scrollTop: st, start: win.start, end: win.end }"
    },
    {
      "name": "oas-window-request",
      "detail": "{ start: need.start, end: need.end, reason } | { start: need.start, end: need.end, reason: 'scroll' }"
    }
