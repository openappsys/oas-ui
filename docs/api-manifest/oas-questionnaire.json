  "methods": [
    {
      "name": "next",
      "signature": "next(): Promise<boolean>",
      "description": "下一步：单步校验门控（当前步 oas-form 未过不放行；无 form / validation=\"false\" 放行）。"
    },
    {
      "name": "prev",
      "signature": "prev(): boolean",
      "description": "上一步：不校验（对齐「回退不被校验挡住」惯例）"
    },
    {
      "name": "goto",
      "signature": "goto(index: number): boolean",
      "description": "直跳任意步：不走单步门控（与 next() 语义分离）；越界夹取、hidden 步向后解析"
    },
    {
      "name": "skipStep",
      "signature": "skipStep(): boolean",
      "description": "跳过当前可选步：不校验直接前进（before-change 仍可拦截）。"
    },
    {
      "name": "validate",
      "signature": "validate(): Promise<boolean>",
      "description": "校验全部参与步（非 hidden 且未跳过，不提交）：每步派发 oas-step-validate，返回是否全部通过。"
    },
    {
      "name": "submit",
      "signature": "submit(): Promise<boolean>",
      "description": "提交：重校全部参与步（含早期步），全过才派发 oas-submit{values}（跨步汇总，仅参与步）"
    },
    {
      "name": "getValues",
      "signature": "getValues(): Record<string, unknown>",
      "description": "跨步值汇总（参与步口径，与 validateAll 同判据）：各参与步（非 hidden 且未跳过）的"
    },
    {
      "name": "reset",
      "signature": "reset(): void",
      "description": "重置：全部步骤 form reset 回初始值（清错误态）、清值跟踪、清跳过记录、current 回 0。"
    }
  ],
  "events": [
    {
      "name": "oas-change",
      "detail": "{ index: eff, ...this.keyOf(eff) } | { index: idx, ...this.keyOf(idx) } | { index: target, ...this.keyOf(target) }"
    },
    {
      "name": "oas-before-change",
      "detail": "{ index: idx, ...this.keyOf(idx), from } | { index: target, ...this.keyOf(target), from }"
    },
    {
      "name": "oas-skip",
      "detail": "{ index: from, ...this.keyOf(from) }"
    },
    {
      "name": "oas-step-validate",
      "detail": "{ index: idx, ...this.keyOf(idx), valid: ok, errors }"
    },
    {
      "name": "oas-submit",
      "detail": "{ values: this.getValues() }"
    }
  ],
