    },
    {
      "name": "oas-event-click",
      "detail": "{ id: ev.id, event: { ...ev } } satisfies SchedulerEventClickDetail"
    },
    {
      "name": "oas-remind",
      "detail": "{ id, event: { ...ev } } satisfies SchedulerRemindDetail"
    },
    {
      "name": "oas-create",
