    },
    {
      "name": "downloadIcs",
      "signature": "downloadIcs(filename: unknown, options?: IcsExportOptions): string",
      "description": "下载当前事件的 ICS 文件（浏览器环境；返回生成的 ICS 字符串便于测试/宿主复用）"
    },
    {
      "name": "addEvent",
