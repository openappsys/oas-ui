  "events": [
    {
      "name": "oas-tasks-change",
      "detail": "{ tasks: this.tasks } satisfies GanttTasksChangeDetail"
    },
    {
      "name": "oas-expand-change",
      "detail": "{ id, expanded: willExpand } satisfies GanttExpandChangeDetail"
    },
    {
      "name": "oas-scale-change",
      "detail": "{ scale } satisfies GanttScaleChangeDetail"
    },
    {
      "name": "oas-task-render",
      "detail": "{ task: this.taskSnapshot(row.task), element: bar } satisfies GanttTaskRenderDetail"
    },
    {
      "name": "oas-task-click",
      "detail": "{ id: row.task.id, task: this.taskSnapshot(row.task) } satisfies GanttTaskClickDetail"
    },
    {
      "name": "oas-task-dblclick",
      "detail": "{ id: row.task.id, task: this.taskSnapshot(row.task) } satisfies GanttTaskClickDetail"
    },
    {
      "name": "oas-task-change",
      "detail": "{ id, task: this.taskSnapshot(this._tasks.find((t) => t.id === id)!), oldStart: this.fmtIso(oldStartMs, datetime), oldEnd: task.end ? this.fmtEnd(oldEndMs, datetime) : start, start, end: endStr, } satisfies GanttTaskChangeDetail"
    },
    {
      "name": "oas-progress-change",
      "detail": "{ id, task: this.taskSnapshot(this._tasks.find((t) => t.id === id)!), progress, } satisfies GanttProgressChangeDetail"
    }
  ],
