{
  "config": {
    "default": true,
    // MD013 line-length：中文文档无空格分词、长句一行轻松超行宽（且 prettier proseWrap
    // 从不折行），939 处误报证明该规则与中文文档场景冲突，禁用（非偷懒，属规则适用性决策）。
    "MD013": false,
    "MD024": false,
    "MD033": false,
    "MD036": false,
    "MD041": false,
    "MD059": {
      "allowed_patterns": ["^\\[[^]]+ 链接\\]$", "^\\[[^]]+ 组件\\]$"]
    },
    "MD060": {
      "style": "lax"
    }
  },
  "globs": [
    "packages/docs/docs/**/*.md",
    "docs/**/*.md",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "AGENTS.md"
  ],
  "ignores": [
    "**/node_modules/**",
    "**/.vitepress/**",
    "**/dist/**"
  ]
}
