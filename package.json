{
  "name": "oas-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "pnpm --filter @oas-ui/docs dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release": "pnpm test && pnpm typecheck && pnpm build && pnpm -r publish --access public"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@oas-ui/theme": "workspace:*",
    "@oas-ui/ui": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "happy-dom": "^20.11.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  }
}
