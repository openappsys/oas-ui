{
  "name": "oas-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "predev": "pnpm -r --filter @oas-ui/ui... build",
    "dev": "pnpm --parallel --filter @oas-ui/core --filter @oas-ui/i18n --filter @oas-ui/icons --filter @oas-ui/ui --filter @oas-ui/docs dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:e2e": "playwright test",
    "test:e2e:docs": "playwright test --project=docs-site",
    "test:e2e:components": "playwright test --project=chromium --project=firefox",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "api:scan": "node scripts/api-docs/scan.mjs",
    "api:gen": "node scripts/api-docs/gen.mjs",
    "api:check": "node scripts/api-docs/scan.mjs && node scripts/api-docs/gen.mjs --check && node scripts/api-docs/check.mjs",
    "stats:gen": "node scripts/stats/gen.mjs",
    "stats:check": "node scripts/stats/gen.mjs && git diff --exit-code -- packages/docs/docs/.vitepress/generated/stats.json",
    "perf:size": "node scripts/perf/size.mjs",
    "perf:bench": "node scripts/perf/render-bench.mjs",
    "release": "pnpm test && pnpm typecheck && pnpm build && pnpm -r publish --access public",
    "lint:md": "markdownlint-cli2",
    "check": "biome check --formatter-enabled=true ."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.11",
    "@oas-ui/theme": "workspace:*",
    "@oas-ui/ui": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "happy-dom": "^20.11.15",
    "markdownlint-cli2": "^0.23.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.11"
  }
}
