{
  "name": "oas-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "predev": "pnpm --filter @oas-ui/ui build",
    "dev": "pnpm --parallel --filter @oas-ui/core --filter @oas-ui/i18n --filter @oas-ui/icons --filter @oas-ui/ui --filter @oas-ui/docs dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:scan": "node scripts/api-docs/scan.mjs",
    "api:gen": "node scripts/api-docs/gen.mjs",
    "api:check": "node scripts/api-docs/scan.mjs && node scripts/api-docs/gen.mjs --check && git diff --exit-code -- docs/api-manifest.json",
    "perf:size": "node scripts/perf/size.mjs",
    "perf:bench": "node scripts/perf/render-bench.mjs",
    "release": "pnpm test && pnpm typecheck && pnpm build && pnpm -r publish --access public",
    "lint:md": "markdownlint-cli2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@oas-ui/theme": "workspace:*",
    "@oas-ui/ui": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "happy-dom": "^20.11.1",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  }
}
