{
  "name": "oas-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || >=26.0.0",
    "pnpm": ">=12"
  },
  "scripts": {
    "predev": "pnpm -r --filter @oas-ui/ui... build && pnpm --filter @oas-ui/theme build",
    "dev": "cross-env CI=true pnpm --parallel --filter @oas-ui/core --filter @oas-ui/i18n --filter @oas-ui/icons --filter @oas-ui/theme --filter @oas-ui/ui --filter @oas-ui/docs dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:e2e": "playwright test",
    "test:e2e:docs": "playwright test --project=docs-site",
    "test:e2e:components": "playwright test --project=chromium --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:shards": "node scripts/e2e/shards.mjs",
    "qa:audit": "node scripts/qa/assert-audit.mjs",
    "qa:audit:check": "node scripts/qa/assert-audit.mjs --check",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "api:scan": "node scripts/api-docs/scan.mjs",
    "api:gen": "node scripts/api-docs/gen.mjs",
    "api:check": "node scripts/api-docs/scan.mjs && node scripts/api-docs/gen.mjs --check && node scripts/api-docs/check.mjs",
    "ssr:matrix": "node scripts/ssr/matrix.mjs",
    "ssr:check": "node scripts/ssr/matrix.mjs --check",
    "deprecations:gen": "node scripts/api-docs/deprecations.mjs",
    "deprecations:check": "node scripts/api-docs/deprecations.mjs --check",
    "scaffold:component": "node scripts/scaffold/component.mjs",
    "scaffold:check": "node --test scripts/scaffold/component.test.mjs",
    "stats:gen": "node scripts/stats/gen.mjs",
    "stats:check": "node scripts/stats/gen.mjs && git diff --exit-code -- packages/docs/docs/.vitepress/generated/stats.json",
    "perf:size": "node scripts/perf/size.mjs",
    "perf:bench": "node scripts/perf/render-bench.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release": "pnpm test && pnpm typecheck && pnpm build && node scripts/publish-skip-existing.mjs",
    "lint:md": "markdownlint-cli2",
    "check": "biome check --formatter-enabled=true .",
    "rtl:audit": "node scripts/e2e/rtl-audit-gate.mjs",
    "rtl:audit:interactive": "node scripts/e2e/rtl-audit-gate.mjs --interactive",
    "visual:review": "node scripts/e2e/visual-review.mjs",
    "llms:gen": "node scripts/llms/gen.mjs",
    "llms:check": "node scripts/llms/gen.mjs --check && git diff --exit-code -- packages/docs/docs/public/llms.txt",
    "skill:check": "node scripts/skills/check.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.5.15",
    "@oas-ui/theme": "workspace:*",
    "@oas-ui/ui": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.18.0",
    "cross-env": "^10.1.0",
    "happy-dom": "^21.0.3",
    "markdownlint-cli2": "^0.23.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
