{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["npm"],
  "timezone": "Asia/Shanghai",
  "schedule": ["before 6am on Monday"],
  "dependencyDashboard": true,
  "prConcurrentLimit": 2,
  "prHourlyLimit": 1,
  "minimumReleaseAge": "5 days",
  "rangeStrategy": "bump",
  "prCreation": "not-pending",
  "lockFileMaintenance": { "enabled": false },
  "ignorePaths": ["packages/ssr/fixtures/**"],
  "packageRules": [
    {
      "description": "devDeps minor/patch 自动合并（前提：分支保护已配 required checks 且开启 Allow auto-merge，否则把 automerge 关掉）",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "牵动基线/工具链迁移的依赖一律人工，PR 内附迁移清单",
      "matchPackageNames": [
        "happy-dom",
        "@biomejs/biome",
        "markdownlint-cli2",
        "shiki",
        "typescript",
        "vite",
        "vitest",
        "@vitejs/plugin-react",
        "@vitejs/plugin-vue",
        "@playwright/test",
        "@axe-core/playwright",
        "@types/node"
      ],
      "automerge": false,
      "labels": ["deps-manual"],
      "prBodyNotes": [
        "人工迁移清单：happy-dom → pnpm perf:bench --update-baseline && pnpm perf:docs；@biomejs/biome → pnpm exec biome migrate --write；markdownlint-cli2 → pnpm lint:md 复查存量；vite / vitest / @playwright/test → 先 pnpm --filter @oas-ui/ui build 再全量 e2e 看 visual snapshot；@types/node → 与 .nvmrc 对齐。"
      ]
    },
    {
      "description": "major 一律走 dependency dashboard 人工审批",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "dependencyDashboardApproval": true
    }
  ]
}
