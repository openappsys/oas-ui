{
  "name": "@oas-ui/icons",
  "version": "1.8.0",
  "description": "OAS-UI 图标（原创内联 SVG）",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "node scripts/generate.mts",
    "build": "node scripts/generate.mts && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
