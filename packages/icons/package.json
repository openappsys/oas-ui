{
  "name": "@oas-ui/icons",
  "version": "2.2.3",
  "description": "OAS-UI 图标（原创内联 SVG）",
  "keywords": [
    "icons",
    "svg",
    "svg-icons",
    "icon-library",
    "inline-svg",
    "oas-ui"
  ],
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/openappsys/oas-ui.git"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE-APACHE",
    "LICENSE-MIT"
  ],
  "scripts": {
    "generate": "node scripts/generate.mts",
    "build": "node scripts/generate.mts && tsc -p tsconfig.build.json",
    "dev": "node scripts/generate.mts && tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}