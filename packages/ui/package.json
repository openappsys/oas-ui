{
  "name": "@oas-ui/ui",
  "version": "2.1.5",
  "description": "OAS-UI 框架无关 Web Components UI 组件库",
  "keywords": [
    "web-components",
    "custom-elements",
    "shadow-dom",
    "ui",
    "ui-components",
    "component-library",
    "design-system",
    "framework-agnostic",
    "oas-ui"
  ],
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/openappsys/oas-ui.git"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ssr": {
      "types": "./dist/types/ssr.d.ts",
      "default": "./dist/ssr.js"
    },
    "./*": {
      "types": "./dist/types/*/index.d.ts",
      "default": "./dist/*/index.js"
    }
  },
  "sideEffects": [
    "**/*.css",
    "**/index.js",
    "**/index.ts"
  ],
  "files": [
    "dist",
    "LICENSE-APACHE",
    "LICENSE-MIT"
  ],
  "scripts": {
    "build": "vite build && vite build --config vite.cdn.config.ts && tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@oas-ui/core": "workspace:*",
    "@oas-ui/i18n": "workspace:*",
    "@oas-ui/icons": "workspace:*"
  },
  "devDependencies": {
    "@oas-ui/ssr": "workspace:*"
  }
}
