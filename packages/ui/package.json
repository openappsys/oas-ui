{
  "name": "@oas-ui/ui",
  "version": "2.3.2",
  "description": "OAS-UI 框架无关 Web Components UI 组件库",
  "homepage": "https://oas-ui.dev/",
  "keywords": [
    "web-components",
    "custom-elements",
    "shadow-dom",
    "ui",
    "ui-components",
    "component-library",
    "design-system",
    "framework-agnostic",
    "oas-ui"
  ],
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/openappsys/oas-ui.git"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ssr": {
      "types": "./dist/types/ssr.d.ts",
      "default": "./dist/ssr.js"
    },
    "./cdn/*": {
      "types": "./dist/types/families/*.d.ts",
      "default": "./dist/cdn/*.js"
    },
    "./floating/app": {
      "types": "./dist/types/framework/app/index.d.ts",
      "default": "./dist/framework/app/index.js"
    },
    "./floating/config-provider": {
      "types": "./dist/types/framework/config-provider/index.d.ts",
      "default": "./dist/framework/config-provider/index.js"
    },
    "./floating/theme-editor": {
      "types": "./dist/types/framework/theme-editor/index.d.ts",
      "default": "./dist/framework/theme-editor/index.js"
    },
    "./floating/command": {
      "types": "./dist/types/navigation/command/index.d.ts",
      "default": "./dist/navigation/command/index.js"
    },
    "./floating/contextmenu": {
      "types": "./dist/types/navigation/contextmenu/index.d.ts",
      "default": "./dist/navigation/contextmenu/index.js"
    },
    "./floating/dropdown": {
      "types": "./dist/types/navigation/dropdown/index.d.ts",
      "default": "./dist/navigation/dropdown/index.js"
    },
    "./floating/menu": {
      "types": "./dist/types/navigation/menu/index.d.ts",
      "default": "./dist/navigation/menu/index.js"
    },
    "./floating/menubar": {
      "types": "./dist/types/navigation/menubar/index.d.ts",
      "default": "./dist/navigation/menubar/index.js"
    },
    "./floating/navigation-menu": {
      "types": "./dist/types/navigation/navigation-menu/index.d.ts",
      "default": "./dist/navigation/navigation-menu/index.js"
    },
    "./floating/speed-dial": {
      "types": "./dist/types/navigation/speed-dial/index.d.ts",
      "default": "./dist/navigation/speed-dial/index.js"
    },
    "./floating/toolbar": {
      "types": "./dist/types/navigation/toolbar/index.d.ts",
      "default": "./dist/navigation/toolbar/index.js"
    },
    "./floating/hover-card": {
      "types": "./dist/types/feedback/hover-card/index.d.ts",
      "default": "./dist/feedback/hover-card/index.js"
    },
    "./floating/popover": {
      "types": "./dist/types/feedback/popover/index.d.ts",
      "default": "./dist/feedback/popover/index.js"
    },
    "./floating/tooltip": {
      "types": "./dist/types/feedback/tooltip/index.d.ts",
      "default": "./dist/feedback/tooltip/index.js"
    },
    "./floating/scroll-area": {
      "types": "./dist/types/layout/scroll-area/index.d.ts",
      "default": "./dist/layout/scroll-area/index.js"
    },
    "./layout/affix": {
      "types": "./dist/types/navigation/affix/index.d.ts",
      "default": "./dist/navigation/affix/index.js"
    },
    "./layout/float-button": {
      "types": "./dist/types/navigation/float-button/index.d.ts",
      "default": "./dist/navigation/float-button/index.js"
    },
    "./layout/page-header": {
      "types": "./dist/types/navigation/page-header/index.d.ts",
      "default": "./dist/navigation/page-header/index.js"
    },
    "./layout/pagination": {
      "types": "./dist/types/navigation/pagination/index.d.ts",
      "default": "./dist/navigation/pagination/index.js"
    },
    "./layout/steps": {
      "types": "./dist/types/navigation/steps/index.d.ts",
      "default": "./dist/navigation/steps/index.js"
    },
    "./layout/tabs": {
      "types": "./dist/types/navigation/tabs/index.d.ts",
      "default": "./dist/navigation/tabs/index.js"
    },
    "./layout/segmented": {
      "types": "./dist/types/form/segmented/index.d.ts",
      "default": "./dist/form/segmented/index.js"
    },
    "./data/aspect-ratio": {
      "types": "./dist/types/layout/aspect-ratio/index.d.ts",
      "default": "./dist/layout/aspect-ratio/index.js"
    },
    "./data/masonry": {
      "types": "./dist/types/layout/masonry/index.d.ts",
      "default": "./dist/layout/masonry/index.js"
    },
    "./*": {
      "types": "./dist/types/*/index.d.ts",
      "default": "./dist/*/index.js"
    }
  },
  "sideEffects": [
    "**/*.css",
    "**/index.js",
    "**/index.ts"
  ],
  "files": [
    "dist",
    "LICENSE-APACHE",
    "LICENSE-MIT"
  ],
  "scripts": {
    "build": "vite build && vite build --config vite.cdn.config.ts && node scripts/build-cdn.mjs && tsc -p tsconfig.build.json",
    "build:cdn": "node scripts/build-cdn.mjs",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@oas-ui/core": "workspace:*",
    "@oas-ui/i18n": "workspace:*",
    "@oas-ui/icons": "workspace:*"
  },
  "devDependencies": {
    "@oas-ui/ssr": "workspace:*"
  }
}
