{
  "name": "@oas-ui/core",
  "version": "2.6.7",
  "description": "OAS-UI 基础运行时（Web Components 基类与工具）",
  "homepage": "https://oas-ui.dev/",
  "keywords": [
    "web-components",
    "custom-elements",
    "shadow-dom",
    "runtime",
    "base-element",
    "oas-ui"
  ],
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/openappsys/oas-ui.git"
  },
  "type": "module",
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || >=26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./format-byte": {
      "types": "./dist/format-byte.d.ts",
      "default": "./dist/format-byte.js"
    },
    "./oas-element": {
      "types": "./dist/oas-element.d.ts",
      "default": "./dist/oas-element.js"
    },
    "./form-element": {
      "types": "./dist/form-element.d.ts",
      "default": "./dist/form-element.js"
    },
    "./escape": {
      "types": "./dist/escape.d.ts",
      "default": "./dist/escape.js"
    },
    "./config-context": {
      "types": "./dist/config-context.d.ts",
      "default": "./dist/config-context.js"
    },
    "./translator": {
      "types": "./dist/translator.d.ts",
      "default": "./dist/translator.js"
    },
    "./locale-tag": {
      "types": "./dist/locale-tag.d.ts",
      "default": "./dist/locale-tag.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE-APACHE",
    "LICENSE-MIT"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
