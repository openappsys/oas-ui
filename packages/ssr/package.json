{
  "name": "@oas-ui/ssr",
  "version": "2.2.4",
  "description": "OAS-UI 服务端渲染（SSR）——renderToString 产出 Declarative Shadow DOM（DSD）静态快照",
  "keywords": [
    "ssr",
    "server-side-rendering",
    "web-components",
    "declarative-shadow-dom",
    "dsd",
    "render-to-string",
    "oas-ui"
  ],
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/openappsys/oas-ui.git"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE-APACHE",
    "LICENSE-MIT"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@oas-ui/i18n": "workspace:*",
    "@oas-ui/ui": "workspace:*",
    "happy-dom": "^20.11.2"
  }
}