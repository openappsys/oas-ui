{
  "name": "@oas-ui/react",
  "version": "2.4.1",
  "description": "OAS-UI React 桥接——useOasEvent / useOasEvents 把 oas-* CustomEvent 桥接为 React hooks（React 19 不把 onXxx prop 桥接到 kebab-case 自定义事件）",
  "keywords": [
    "react",
    "react-hooks",
    "hooks",
    "custom-elements",
    "web-components",
    "custom-event",
    "bridge",
    "oas-ui"
  ],
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE-APACHE",
    "LICENSE-MIT"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/openappsys/oas-ui.git"
  }
}
