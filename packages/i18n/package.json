{
  "name": "@oas-ui/i18n",
  "version": "0.1.0",
  "description": "OAS-UI 国际化（locale registry + 语言包，组件内置文案统一入口）",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./zh-CN": {
      "types": "./dist/zh-CN.d.ts",
      "default": "./dist/zh-CN.js"
    },
    "./en": {
      "types": "./dist/en.d.ts",
      "default": "./dist/en.js"
    }
  },
  "sideEffects": [
    "./dist/index.js"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@oas-ui/core": "workspace:*"
  }
}
