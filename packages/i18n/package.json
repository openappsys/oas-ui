{
  "name": "@oas-ui/i18n",
  "version": "2.5.3",
  "description": "OAS-UI 国际化（locale registry + 语言包，组件内置文案统一入口）",
  "homepage": "https://oas-ui.dev/",
  "keywords": [
    "i18n",
    "internationalization",
    "localization",
    "l10n",
    "locale",
    "web-components",
    "oas-ui"
  ],
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/openappsys/oas-ui.git"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./zh-CN": {
      "types": "./dist/zh-CN.d.ts",
      "default": "./dist/zh-CN.js"
    },
    "./en": {
      "types": "./dist/en.d.ts",
      "default": "./dist/en.js"
    },
    "./ja": {
      "types": "./dist/ja.d.ts",
      "default": "./dist/ja.js"
    },
    "./ko": {
      "types": "./dist/ko.d.ts",
      "default": "./dist/ko.js"
    },
    "./de": {
      "types": "./dist/de.d.ts",
      "default": "./dist/de.js"
    },
    "./fr": {
      "types": "./dist/fr.d.ts",
      "default": "./dist/fr.js"
    },
    "./es": {
      "types": "./dist/es.d.ts",
      "default": "./dist/es.js"
    },
    "./pt": {
      "types": "./dist/pt.d.ts",
      "default": "./dist/pt.js"
    },
    "./ru": {
      "types": "./dist/ru.d.ts",
      "default": "./dist/ru.js"
    },
    "./ar": {
      "types": "./dist/ar.d.ts",
      "default": "./dist/ar.js"
    }
  },
  "sideEffects": [
    "./dist/index.js"
  ],
  "files": [
    "dist",
    "LICENSE-APACHE",
    "LICENSE-MIT"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@oas-ui/core": "workspace:*"
  }
}
