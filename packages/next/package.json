{
  "name": "@oas-ui/next",
  "version": "2.2.7",
  "description": "OAS-UI Next.js（App Router）集成——RSC OasComponent 服务端产 DSD 快照 + OasRegistry 客户端注册引导",
  "keywords": [
    "nextjs",
    "next",
    "react",
    "app-router",
    "rsc",
    "react-server-components",
    "ssr",
    "web-components",
    "oas-ui"
  ],
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "react-server": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "sideEffects": [
    "./dist/client.js"
  ],
  "files": [
    "dist",
    "LICENSE-APACHE",
    "LICENSE-MIT"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "next": ">=13.4.0",
    "@oas-ui/ssr": "^2.0.0",
    "@oas-ui/ui": "^2.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@oas-ui/ssr": "workspace:*",
    "@oas-ui/ui": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/openappsys/oas-ui.git"
  }
}
